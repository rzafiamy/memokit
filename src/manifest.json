{
  "manifest_version": 3,
  "name": "MemoKit",
  "version": "1.3.0",
  "description": "Premium tab management and restoration kit.",
  "author": "Makix team - infodev.ovh",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "omnibox": {
    "keyword": "mk"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Open MemoKit (search profiles and sites)"
    },
    "undo-switch": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Undo the last profile switch"
    },
    "restore-startup": {
      "description": "Restore startup tabs"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
